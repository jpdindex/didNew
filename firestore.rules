rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function manager() {
      return signedIn() && request.auth.token.email in ['jpdindex@gmail.com'];
    }
    function draft(draftId) { return get(/databases/$(database)/documents/inputDrafts/$(draftId)); }
    function participant(draftId) {
      return signedIn() && request.auth.uid in draft(draftId).data.participants;
    }

    // Live collaboration lives only below inputDrafts. The root document is
    // created by the authenticated backend join endpoint; clients may update
    // only shared state, never its role assignment or validated payload.
    match /inputDrafts/{draftId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if false;
      allow update: if participant(draftId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sharedState', 'updatedAt', 'updatedBy']);
      allow delete: if false;

      match /records/{recordId} {
        allow read, create, update: if participant(draftId);
        allow delete: if false;
      }
    }

    // Signed-in analysts still need fixture and roster reference data.
    match /matches/{matchId} { allow read: if signedIn(); allow write: if manager(); }
    match /matches/{matchId}/inputSnapshots/{document=**} { allow read: if signedIn(); }
    match /players/{document=**} { allow read: if signedIn(); allow write: if manager(); }
    match /teams/{document=**} { allow read: if signedIn(); allow write: if manager(); }
    // Registration requests and revision markers are served by the authenticated
    // API. Clients cannot bypass review by writing approval or roster data.
    match /playerRegistrationRequests/{document=**} { allow read, write: if false; }
    match /playerRegistrationRosterVersions/{document=**} { allow read, write: if false; }
    match /stadiums/{document=**} { allow read, write: if manager(); }
    match /coachContracts/{document=**} { allow read, write: if manager(); }
    match /coaches/{document=**} { allow read, write: if manager(); }
    match /leagues/{document=**} { allow read: if signedIn(); allow write: if manager(); }
    match /seasons/{document=**} { allow read: if signedIn(); allow write: if manager(); }
    match /ratingBaseline/{document=**} { allow read: if signedIn(); }
    match /recorders/{uid} {
      allow read: if manager() || (signedIn() && request.auth.uid == uid);
      allow write: if manager();
    }
  }
}
