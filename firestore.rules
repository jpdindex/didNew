rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function draft(draftId) { return get(/databases/$(database)/documents/inputDrafts/$(draftId)); }
    function participant(draftId) {
      return signedIn() && request.auth.uid in draft(draftId).data.participants;
    }

    // Live collaboration lives only below inputDrafts. The root document is
    // created by the authenticated backend join endpoint; clients may update
    // only shared state, never its role assignment or validated payload.
    match /inputDrafts/{draftId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if false;
      allow update: if participant(draftId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sharedState', 'updatedAt', 'updatedBy']);
      allow delete: if false;

      match /records/{recordId} {
        allow read, create, update: if participant(draftId);
        allow delete: if false;
      }
    }

    // Existing management screens retain their authenticated CRUD surface.
    // RAW recordings are intentionally omitted: only the backend Admin SDK
    // promotes a finalized Draft into matches/.../recordings.
    match /matches/{matchId} { allow read, write: if signedIn(); }
    match /matches/{matchId}/inputSnapshots/{document=**} { allow read: if signedIn(); }
    match /players/{document=**} { allow read, write: if signedIn(); }
    match /teams/{document=**} { allow read, write: if signedIn(); }
    match /stadiums/{document=**} { allow read, write: if signedIn(); }
    match /coachContracts/{document=**} { allow read, write: if signedIn(); }
    match /coaches/{document=**} { allow read, write: if signedIn(); }
    match /leagues/{document=**} { allow read, write: if signedIn(); }
    match /seasons/{document=**} { allow read, write: if signedIn(); }
    match /ratingBaseline/{document=**} { allow read: if signedIn(); }
    match /recorders/{document=**} { allow read, write: if signedIn(); }
  }
}
